{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CAN: Compile Shift Register",
            "type": "shell",
            "command": "C:\\iverilog\\bin\\iverilog.exe",
            "args": [
                "-o",
                "shift_sim.out",
                "rtl/shift_register.v",
                "tb/shift_register_tb.v"
            ],
            "problemMatcher": []
        },
        {
            "label": "CAN: Run Shift Register Simulation",
            "type": "shell",
            "command": "C:\\iverilog\\bin\\vvp.exe",
            "args": [
                "shift_sim.out"
            ],
            "dependsOn": "CAN: Compile Shift Register",
            "problemMatcher": []
        },
        {
            "label": "CAN: Compile Bit Timing",
            "type": "shell",
            "command": "C:\\iverilog\\bin\\iverilog.exe",
            "args": [
                "-o",
                "bit_timing_sim.out",
                "rtl/bit_timing.v",
                "tb/tb/bit_timing_tb.v"
            ],
            "problemMatcher": []
        },
        {
            "label": "CAN: Run Bit Timing Simulation",
            "type": "shell",
            "command": "C:\\iverilog\\bin\\vvp.exe",
            "args": [
                "bit_timing_sim.out"
            ],
            "dependsOn": "CAN: Compile Bit Timing",
            "problemMatcher": []
        },
        {
            "label": "CAN: Compile CAN TX",
            "type": "shell",
            "command": "C:\\iverilog\\bin\\iverilog.exe",
            "args": [
                "-g2012",
                "-o",
                "can_tx_sim.out",
                "rtl/can_tx.v",
                "tb/can_tx_tb.v"
            ],
            "problemMatcher": []
        },
        {
            "label": "CAN: Run CAN TX Simulation",
            "type": "shell",
            "command": "C:\\iverilog\\bin\\vvp.exe",
            "args": [
                "can_tx_sim.out"
            ],
            "dependsOn": "CAN: Compile CAN TX",
            "problemMatcher": []
        },
        {
            "label": "CAN: Open CAN TX Waveform",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gtkwave.exe",
            "args": [
                "${workspaceFolder}\\can_tx.vcd"
            ],
            "dependsOn": "CAN: Run CAN TX Simulation",
            "problemMatcher": []
        },
        {
            "label": "CAN: Open Waveform",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gtkwave.exe",
            "args": [
                "-a",
                "${workspaceFolder}\\bit_timing.gtkw",
                "${workspaceFolder}\\bit_timing.vcd"
            ],
            "dependsOn": "CAN: Run Bit Timing Simulation",
            "problemMatcher": []
        },
        {
            "label": "CAN: Simulate + Waveform",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CAN: Open Waveform"
            ],
            "problemMatcher": []
        },
        {
            "label": "CAN: Simulate TX + Waveform",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CAN: Open CAN TX Waveform"
            ],
            "problemMatcher": []
        }
    ]
}